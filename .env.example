ANTHROPIC_API_KEY=sk-ant-api-key-here

SENDGRID_API_KEY=SG.your-sendgrid-key-here

DATABASE_URL=sqlite:///data/epstein.db


FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-to-random-string

API_RATE_LIMIT=100
API_TIMEOUT=30

CACHE_DIR=data/cache
CACHE_PDFS=true
CACHE_MAX_SIZE_GB=10

MONITOR_DEFAULT_INTERVAL=24
MONITOR_BATCH_SIZE=10

LOG_LEVEL=INFO
LOG_FILE=data/logs/epstein.log

